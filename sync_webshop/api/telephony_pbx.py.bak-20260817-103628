@frappe.whitelist(allow_guest=True)
def voicemail_alert(token=None, mailbox=None, caller=None, duration=None,
                    when=None):
	"""عميل ساب رسالة صوتية بعد المواعيد — تنبيه واتساب فورًا."""
	_check(token)

	number = _digits(caller)
	customer, customer_name = find_customer(number)

	try:
		content = frappe.get_single("Webshop Content Settings")
		from sync_webshop.api.owner_alerts import _recipients, _send
		numbers = _recipients(content)
		if not numbers:
			return {"ok": 0, "reason": "مفيش أرقام تنبيه في الإعدادات"}

		secs = _int(duration)
		text = (
			"🔊 *رسالة صوتية بعد المواعيد*\n\n"
			f"من: {number or 'رقم مستخفي'}\n"
			f"العميل: {customer_name or 'رقم مش عندنا'}\n"
			+ (f"مدة الرسالة: {secs} ثانية\n" if secs else "")
			+ (f"الوقت: {when}\n" if when else "")
			+ "\nاسمعها من لوحة السنترال — صندوق 9000."
		)
		sent = 0
		for target in numbers:
			ok, _detail = _send(content, target, text)
			sent += 1 if ok else 0
		return {"ok": 1, "sent": sent, "customer": customer_name}
	except Exception:
		frappe.log_error(frappe.get_traceback(), "voicemail_alert")
		return {"ok": 0, "reason": "فشل الإرسال — اتسجّل في سجل الأخطاء"}


@frappe.whitelist(allow_guest=True)
def pending_recordings(token=None, limit=500):
	"""أرقام المكالمات اللي لسه من غير تسجيل — عشان السنترال يرفعلها بس.

	من غير كده السنترال هيرفع كل تسجيل عنده (8.5 جيجا) وأغلبها لمكالمات
	قديمة مش متسجّلة في ERPNext أصلًا.
	"""
	_check(token)
	rows = frappe.get_all("Call Log",
		filters={"recording_url": ["in", ["", None]], "duration": [">", 0]},
		fields=["id"], order_by="start_time desc",
		limit=frappe.utils.cint(limit) or 500)
	return {"calls": [r.id for r in rows if r.id]}
